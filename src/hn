#!/usr/bin/env python3
import os
import argparse
from ssh import parse_ssh_config, format_ssh_connection
import inquirer


def select_ssh_host(ssh_config):
    choices = [
        (f"{host} ({format_ssh_connection(config)})", host)
        for host, config in ssh_config.items()
    ]

    questions = [
        inquirer.List(
            "host",
            message="Select SSH host to connect to",
            choices=choices,
        )
    ]
    answers = inquirer.prompt(questions)

    if answers and "host" in answers:
        return answers["host"]
    else:
        return None


def exec_ssh(connection_string):
    os.execvp("ssh", ["ssh", connection_string])


def select_and_connect(ssh_config):
    selected_host = select_ssh_host(ssh_config)

    if selected_host:
        ssh_selection = ssh_config[selected_host]
        connection_string = format_ssh_connection(ssh_selection)
        exec_ssh(connection_string)
    else:
        print("No host selected.")


