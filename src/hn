def main():
    # Parse the SSH config file
    ssh_config = parse_ssh_config()

    # Set up argument parsing
    parser = argparse.ArgumentParser(description="SSH connection utility.")
    parser.add_argument(
        "hostname",
        nargs="?",
        help="Optional hostname to connect to directly.",
    )
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--key-check", action="store_true", help="Check SSH keys.")
    group.add_argument("--key-copy", action="store_true", help="Copy SSH keys.")
    args = parser.parse_args()

    # Handle arguments
    if args.key_check:
        key_check(ssh_config)
    elif args.key_copy:
        key_copy(ssh_config)
    elif args.hostname:
        exec_ssh(args.hostname)
    else:
        select_and_connect(ssh_config)


if __name__ == "__main__":
    main()
